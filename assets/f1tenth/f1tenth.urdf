<?xml version="1.0"?>
<!--
  F1TENTH 1/10 스케일 차량 (Ackermann 조향, 4륜)

  좌표/치수 (실제 F1TENTH 계열 근사)
    - 전진 방향: +x,  좌측: +y,  위: +z
    - 휠베이스(wheelbase)      L = 0.33 m   (앞축 x=+0.165, 뒤축 x=-0.165)  [실측]
    - 윤거(track width)        W = 0.255 m  (좌/우 바퀴 y=±0.1275)  [실측]
    - 바퀴 반경 r = 0.06 m, 폭 0.045 m  [실측]
    - base_link 원점 = 차축 높이. 스폰 시 z=0.06 로 두면 바퀴 바닥이 지면(z=0)에 닿음.
    - 질량 실측(코너웨이트): 총 3.9406 kg, 앞 55%/뒤 45% -> 섀시 CoM x=+0.0135

  조인트 이름은 dacerpp_lab/car_cfg.py 와 일치:
    조향(revolute, axis z, ±0.44rad 기계 한계): steering_joint_left, steering_joint_right
    구동(continuous, axis y)       : wheel_joint_rear_left, wheel_joint_rear_right
    앞바퀴 회전(continuous, axis y): wheel_joint_front_left, wheel_joint_front_right

  기하는 박스/실린더 프리미티브만 사용 -> 외부 메시 의존 없이 USD 변환이 깨끗함.
  (외형 메시는 나중에 visual 만 교체하면 됨)
-->
<robot name="f1tenth">

  <!-- ===================== 재질 ===================== -->
  <material name="chassis_red"><color rgba="0.75 0.10 0.10 1.0"/></material>
  <material name="wheel_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="hub_gray"><color rgba="0.4 0.4 0.4 1.0"/></material>

  <!-- ===================== 섀시 ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.46 0.18 0.05"/></geometry>
      <material name="chassis_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.46 0.18 0.05"/></geometry>
    </collision>
    <inertial>
      <!-- 2026-08-18: 코너웨이트 실측 반영 (generated/weight_{total,front,rear}.jpg).
           총 4.532kg = base_link 4.032 + 바퀴 4x0.1 + 조향너클 2x0.05.
           ★ env_cfg.py TireModelCfg.mass(4.532) 와 반드시 같은 총합이어야 한다 —
             여기(URDF->USD)는 PhysX 의 운동 적분용 질량이고, TireModelCfg.mass 는
             해석 타이어 모델의 수직하중(Nf/Nr) 계산용이라 둘이 어긋나면
             '4.53kg 만큼의 그립으로 4.24kg 를 가속'하는 비물리가 된다.
           CoM x: 앞뒤 배분이 55:45 -> 50:50 (실측 2280g/2252g) 이므로 CoM 이 축거
             중앙으로 왔다. 0.0135(중앙 앞 13.5mm) -> 0.001.
           관성: base_link 질량비(4.032/3.741 = 1.0778)로 비례 보정했다.
             ★ 이것도 근사다. 증가분 591g 의 앞뒤 배분은 이제 알지만(앞 119g / 뒤 472g
               = 20:80) 섀시 위 '어디에' 있는지는 모른다. 뒤축 집중이라 가정하면
               평행축 항으로 izz 가 여기서 +0.016 정도 더 커진다(상한). 배터리/전장품
               실제 위치를 알게 되면 그 항까지 반영할 것 — 지금은 요 응답이 실제보다
               조금 빠른 쪽으로 남아 있다. -->
      <origin xyz="0.001 0 0.02" rpy="0 0 0"/>
      <mass value="4.032"/>
      <inertia ixx="0.010786" ixy="0.0" ixz="0.0"
               iyy="0.066170" iyz="0.0" izz="0.075410"/>
    </inertial>
  </link>

  <!-- ===================== 조향 너클(앞 좌/우) ===================== -->
  <link name="front_left_steer_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.04"/></geometry>
      <material name="hub_gray"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="5e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="5e-5"/>
    </inertial>
  </link>

  <link name="front_right_steer_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.04"/></geometry>
      <material name="hub_gray"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="5e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="5e-5"/>
    </inertial>
  </link>

  <!-- ===================== 바퀴 4개 ===================== -->
  <!-- 실린더 기본축은 z. rpy=(90deg,0,0) 으로 회전해 회전축을 y 로 정렬.
       회전축 y 이므로 spin 관성 Iyy(1.8e-4), 횡관성 Ixx/Izz(1.07e-4). r=0.06 실측. -->
  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.045"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1.07e-4" ixy="0" ixz="0" iyy="1.80e-4" iyz="0" izz="1.07e-4"/>
    </inertial>
  </link>

  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.045"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1.07e-4" ixy="0" ixz="0" iyy="1.80e-4" iyz="0" izz="1.07e-4"/>
    </inertial>
  </link>

  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.045"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1.07e-4" ixy="0" ixz="0" iyy="1.80e-4" iyz="0" izz="1.07e-4"/>
    </inertial>
  </link>

  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.045"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1.07e-4" ixy="0" ixz="0" iyy="1.80e-4" iyz="0" izz="1.07e-4"/>
    </inertial>
  </link>

  <!-- ===================== 조인트 ===================== -->
  <!-- 앞 좌: base -> 조향너클(revolute z) -> 바퀴(continuous y) -->
  <joint name="steering_joint_left" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steer_link"/>
    <origin xyz="0.165 0.1275 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.44" upper="0.44" effort="10.0" velocity="10.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>
  <joint name="wheel_joint_front_left" type="continuous">
    <parent link="front_left_steer_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- 앞 우 -->
  <joint name="steering_joint_right" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steer_link"/>
    <origin xyz="0.165 -0.1275 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.44" upper="0.44" effort="10.0" velocity="10.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>
  <joint name="wheel_joint_front_right" type="continuous">
    <parent link="front_right_steer_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- 뒤 좌/우: base 에 직접 구동 바퀴 -->
  <joint name="wheel_joint_rear_left" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.165 0.1275 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <joint name="wheel_joint_rear_right" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.165 -0.1275 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

</robot>
